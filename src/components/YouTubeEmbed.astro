---
export interface Props {
  id: string;
  title?: string;
}

const { id, title = "Video Walkthrough" } = Astro.props;
---

{id && (
  <div class="my-6">
    <div class="relative w-full overflow-hidden rounded-xl bg-neutral-900 shadow-lg" style="padding-top: 56.25%;">
      <iframe
        class="absolute top-0 left-0 w-full h-full border-0"
        src={`https://www.youtube-nocookie.com/embed/${id}`}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
    <p class="mt-2 text-center text-xs text-neutral-400 italic">
      📺 Prefer video? Watch the homelab walkthrough above, or follow the complete step-by-step written guide below.
    </p>
  </div>
)}
